/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.tailwindcss.com; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.tailwindcss.com; connect-src 'self' https:; media-src 'self' https:; object-src 'none'; upgrade-insecure-requests

/index.html
  Cache-Control: no-store
/strapper.html
  Cache-Control: no-store
/about.html
  Cache-Control: no-store
/docs.html
  Cache-Control: no-store
/note.html
  Cache-Control: no-store
/sw.js
  Cache-Control: no-store

/cursor.css
  Cache-Control: public, max-age=3600
/trail.css
  Cache-Control: public, max-age=3600
/trail.js
  Cache-Control: public, max-age=3600
/trail.min.js
  Cache-Control: public, max-age=3600
/Logo.png
  Cache-Control: public, max-age=3600
